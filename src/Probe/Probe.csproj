<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(NoWinRt)' != 'true'">net8.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(NoWinRt)' == 'true'">net8.0-windows</TargetFramework>
    <DefineConstants Condition="'$(NoWinRt)' != 'true'">$(DefineConstants);USE_WINRT</DefineConstants>
    <RootNamespace>Probe</RootNamespace>
    <AssemblyName>Probe</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyTitle>PeripheralBattery Probe</AssemblyTitle>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

</Project>
